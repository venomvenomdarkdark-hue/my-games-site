<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>VENOM OPEN WORLD</title>

<style>
* {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

body {
  margin: 0;
  overflow: hidden;
  background: #83b9d6;
  font-family: Arial, sans-serif;
  touch-action: none;
}

canvas {
  display: block;
  width: 100%;
  height: 100%;
}

#hud {
  position: absolute;
  top: 10px;
  left: 10px;
  color: white;
  background: #101820dd;
  padding: 12px;
  border: 1px solid #00e5ff;
  border-radius: 10px;
  pointer-events: none;
}

#hud strong {
  color: #00e5ff;
}

#help {
  font-size: 12px;
  margin-top: 6px;
}

#controls {
  position: absolute;
  bottom: 15px;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  align-items: end;
  padding: 0 12px;
}

.group {
  display: flex;
  gap: 7px;
  flex-wrap: wrap;
  max-width: 65%;
}

button {
  min-width: 52px;
  height: 54px;
  border: 2px solid #00e5ff;
  border-radius: 13px;
  color: white;
  background: #111d2ddd;
  font-weight: bold;
  font-size: 17px;
  touch-action: none;
}

button:active {
  background: #007e91;
}

#action {
  border-color: #ffca55;
  min-width: 86px;
}

#shoot {
  border-color: #ff6969;
}

#status {
  position: absolute;
  top: 100px;
  left: 10px;
  color: white;
  background: #111d2ddd;
  padding: 8px;
  border-radius: 8px;
  font-size: 12px;
  max-width: 180px;
}

#loading {
  position: absolute;
  inset: 0;
  background: #101820;
  color: #00e5ff;
  display: grid;
  place-items: center;
  text-align: center;
  z-index: 20;
}
</style>
</head>

<body>

<div id="loading">
  <div>
    <h2>VENOM OPEN WORLD</h2>
    <p>جاري تحميل المدينة...</p>
  </div>
</div>

<div id="hud">
  <strong>VENOM OPEN WORLD</strong>
  <div id="help">تحرك واستكشف المدينة</div>
</div>

<div id="status">أنت ماشي على رجليك</div>

<div id="controls">
  <div class="group">
    <button id="left">◀</button>
    <button id="right">▶</button>
    <button id="forward">▲</button>
    <button id="back">▼</button>
  </div>

  <div class="group">
    <button id="shoot">🎯 تصويب</button>
    <button id="action">🚗 ركوب</button>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>

<script>
(() => {
  const loading = document.getElementById("loading");
  const status = document.getElementById("status");

  if (!window.THREE) {
    loading.innerHTML =
      "<div><h2>تعذر تحميل اللعبة</h2>" +
      "<p>اتأكد من الإنترنت وجرب تفتحها تاني.</p></div>";
    return;
  }

  const scene = new THREE.Scene();
  scene.background = new THREE.Color(0x91c9ed);
  scene.fog = new THREE.Fog(0x91c9ed, 90, 230);

  const camera = new THREE.PerspectiveCamera(
    65, innerWidth / innerHeight, 0.1, 400
  );

  const renderer = new THREE.WebGLRenderer({
    antialias: false,
    powerPreference: "high-performance"
  });

  renderer.setSize(innerWidth, innerHeight);
  renderer.setPixelRatio(Math.min(devicePixelRatio, 1.4));
  document.body.appendChild(renderer.domElement);

  scene.add(new THREE.HemisphereLight(0xffffff, 0x53624b, 2));

  const sun = new THREE.DirectionalLight(0xffffff, 2);
  sun.position.set(30, 70, 20);
  scene.add(sun);

  function mat(color) {
    return new THREE.MeshLambertMaterial({ color });
  }

  const ground = new THREE.Mesh(
    new THREE.PlaneGeometry(400, 400),
    mat(0x5d9850)
  );

  ground.rotation.x = -Math.PI / 2;
  ground.position.y = -0.1;
  scene.add(ground);

  // المدينة والطرق
  const roads = [];
  const buildings = [];
  const roadMat = mat(0x34383e);

  for (let n = -4; n <= 4; n++) {
    const p = n * 32;

    const r1 = new THREE.Mesh(
      new THREE.PlaneGeometry(9, 300),
      roadMat
    );

    r1.rotation.x = -Math.PI / 2;
    r1.position.set(p, 0, 0);
    scene.add(r1);
    roads.push(r1);

    const r2 = new THREE.Mesh(
      new THREE.PlaneGeometry(300, 9),
      roadMat
    );

    r2.rotation.x = -Math.PI / 2;
    r2.position.set(0, 0.01, p);
    scene.add(r2);
    roads.push(r2);
  }

  let seed = 483;

  function rnd() {
    seed = seed * 16807 % 2147483647;
    return (seed - 1) / 2147483646;
  }

  const colors = [
    0xd8dce0, 0xc0b8a8, 0x9caeb9,
    0xe5d7c4, 0x8896a4, 0xc5d1d8
  ];

  for (let x = -4; x < 4; x++) {
    for (let z = -4; z < 4; z++) {
      for (let k = 0; k < 4; k++) {
        const bx = x * 32 + (k % 2 ? 10 : -10);
        const bz = z * 32 + (k < 2 ? -10 : 10);

        const w = 7 + rnd() * 3;
        const d = 7 + rnd() * 3;
        const h = 8 + rnd() * 18;

        const b = new THREE.Mesh(
          new THREE.BoxGeometry(w, h, d),
          mat(colors[Math.floor(rnd() * colors.length)])
        );

        b.position.set(bx, h / 2, bz);
        scene.add(b);
        buildings.push(b);
      }
    }
  }

  // الشخصية المقنعة
  const hero = new THREE.Group();

  const clothes = mat(0x20252c);
  const maskMat = mat(0x080b10);
  const cyan = mat(0x00e5ff);

  function box(parent, size, material, pos) {
    const o = new THREE.Mesh(
      new THREE.BoxGeometry(...size),
      material
    );
    o.position.set(...pos);
    parent.add(o);
    return o;
  }

  box(hero, [0.8, 1.1, 0.42], clothes, [0, 1.35, 0]);
  box(hero, [0.3, 0.85, 0.32], clothes, [-0.58, 1.35, 0]);
  box(hero, [0.3, 0.85, 0.32], clothes, [0.58, 1.35, 0]);
  box(hero, [0.28, 0.85, 0.3], clothes, [-0.22, 0.45, 0]);
  box(hero, [0.28, 0.85, 0.3], clothes, [0.22, 0.45, 0]);

  const head = new THREE.Mesh(
    new THREE.SphereGeometry(0.35, 12, 10),
    maskMat
  );

  head.position.y = 2.15;
  hero.add(head);

  box(hero, [0.42, 0.09, 0.06], cyan, [0, 2.19, -0.3]);

  hero.position.set(0, 0, 3);
  scene.add(hero);

  // العربية
  const car = new THREE.Group();

  box(car, [2, 0.8, 3.8], mat(0x087ed0), [0, 0.85, 0]);
  box(car, [1.5, 0.8, 1.7], mat(0x233c50), [0, 1.5, -0.2]);

  for (const x of [-1.03, 1.03]) {
    for (const z of [-1.2, 1.2]) {
      const wheel = new THREE.Mesh(
        new THREE.CylinderGeometry(0.37, 0.37, 0.22, 10),
        mat(0x151515)
      );
      wheel.rotation.z = Math.PI / 2;
      wheel.position.set(x, 0.4, z);
      car.add(wheel);
    }
  }

  car.position.set(0, 0, -7);
  scene.add(car);

  // أهداف افتراضية للتصويب
  const targets = [];

  for (const [x, z] of [[-12,-15], [12,-20], [20,10]]) {
    const target = new THREE.Group();

    box(target, [0.8, 1.8, 0.6], mat(0xc17a48), [0, 0.9, 0]);

    const headTarget = new THREE.Mesh(
      new THREE.SphereGeometry(0.3, 8, 8),
      mat(0xecd0aa)
    );

    headTarget.position.y = 2.05;
    target.add(headTarget);

    target.position.set(x, 0, z);
    scene.add(target);
    targets.push(target);
  }

  let driving = false;
  let armed = false;
  let score = 0;

  const keys = {
    left: false,
    right: false,
    forward: false,
    back: false
  };

  function bind(id, key) {
    const button = document.getElementById(id);

    button.addEventListener("pointerdown", e => {
      e.preventDefault();
      keys[key] = true;
      button.setPointerCapture(e.pointerId);
    });

    const release = e => {
      e.preventDefault();
      keys[key] = false;
    };

    button.addEventListener("pointerup", release);
    button.addEventListener("pointercancel", release);
    button.addEventListener("lostpointercapture", () => {
      keys[key] = false;
    });
  }

  bind("left", "left");
  bind("right", "right");
  bind("forward", "forward");
  bind("back", "back");

  function updateStatus() {
    status.textContent = driving
      ? "أنت جوه العربية 🚗"
      : "أنت ماشي على رجليك 🥷";

    document.getElementById("action").textContent =
      driving ? "🚶 نزول" : "🚗 ركوب";
  }

  document.getElementById("action").addEventListener("click", () => {
    const distance = hero.position.distanceTo(car.position);

    if (!driving && distance < 5) {
      driving = true;
      hero.visible = false;
      hero.position.copy(car.position);
    } else if (driving) {
      driving = false;
      hero.visible = true;

      hero.position.set(
        car.position.x + 2.5,
        0,
        car.position.z
      );
    } else {
      status.textContent = "قرّب من العربية الأول!";
      return;
    }

    updateStatus();
  });

  document.getElementById("shoot").addEventListener("click", () => {
    armed = true;

    // التصويب على أقرب هدف أمام الشخصية
    const actor = driving ? car : hero;
    const direction = new THREE.Vector3(
      0, 0, -1
    ).applyQuaternion(actor.quaternion);

    let best = null;
    let bestDistance = 35;

    for (const target of targets) {
      if (!target.visible) continue;

      const delta = target.position.clone()
        .sub(actor.position);

      const distance = delta.length();
      delta.y = 0;

      if (distance < bestDistance &&
          direction.dot(delta.normalize()) > 0.75) {
        best = target;
        bestDistance = distance;
      }
    }

    if (best) {
      best.visible = false;
      score++;
      status.textContent = "أصبت هدفًا افتراضيًا! النقاط: " + score;
    } else {
      status.textContent = "مفيش هدف قدامك قريب للتصويب.";
    }
  });

  // لوحة المفاتيح للكمبيوتر
  window.addEventListener("keydown", e => {
    if (e.key === "ArrowUp" || e.key === "w") keys.forward = true;
    if (e.key === "ArrowDown" || e.key === "s") keys.back = true;
    if (e.key === "ArrowLeft" || e.key === "a") keys.left = true;
    if (e.key === "ArrowRight" || e.key === "d") keys.right = true;
  });

  window.addEventListener("keyup", e => {
    if (e.key === "ArrowUp" || e.key === "w") keys.forward = false;
    if (e.key === "ArrowDown" || e.key === "s") keys.back = false;
    if (e.key === "ArrowLeft" || e.key === "a") keys.left = false;
    if (e.key === "ArrowRight" || e.key === "d") keys.right = false;
  });

  function animate() {
    requestAnimationFrame(animate);

    const actor = driving ? car : hero;
    const speed = driving ? 0.18 : 0.11;

    if (keys.left) actor.rotation.y += 0.045;
    if (keys.right) actor.rotation.y -= 0.045;

    let movement = 0;
    if (keys.forward) movement = -speed;
    if (keys.back) movement = speed;

    actor.position.x += Math.sin(actor.rotation.y) * movement;
    actor.position.z += Math.cos(actor.rotation.y) * movement;

    actor.position.x = THREE.MathUtils.clamp(actor.position.x, -140, 140);
    actor.position.z = THREE.MathUtils.clamp(actor.position.z, -140, 140);

    // الكاميرا خلف اللاعب
    const offset = new THREE.Vector3(0, 5, 8);
    offset.applyAxisAngle(new THREE.Vector3(0, 1, 0), actor.rotation.y);

    const desired = actor.position.clone().add(offset);
    camera.position.lerp(desired, 0.12);

    camera.lookAt(
      actor.position.x,
      actor.position.y + 1.2,
      actor.position.z
    );

    renderer.render(scene, camera);
  }

  window.addEventListener("resize", () => {
    camera.aspect = innerWidth / innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(innerWidth, innerHeight);
  });

  loading.style.display = "none";
  updateStatus();
  animate();
})();
</script>
</body>
</html>
